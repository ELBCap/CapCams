  "authors": ["ELB_GG"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.elbgg.capcams.CapCams"],
    "client": ["dev.elbgg.capcams.client.CapCamsClient"]
  },
  "mixins": ["capcams.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "veil": ">=4.5.0",
    "imguimc": ">=2.0.0"
  },
  "suggests": {
    "narrativecraft": "*"
  }
